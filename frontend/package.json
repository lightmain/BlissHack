{
  "name": "blisshack",
  "private": true,
  "version": "0.2.5-alpha.0",
  "productName": "BlissHack",
  "description": "An unofficial NetHack 5.0 port with a modern desktop interface.",
  "author": "The BlissHack contributors",
  "homepage": "https://github.com/lightmain/BlissHack",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:build": "npm run build -- --base /",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && electron-forge package",
    "desktop:package:mac": "npm run desktop:build && electron-forge package --platform=darwin",
    "desktop:package:win": "npm run desktop:build && electron-forge package --platform=win32 --arch=x64",
    "desktop:make": "npm run desktop:build && electron-forge make",
    "desktop:make:mac": "npm run desktop:build && electron-forge make --platform=darwin",
    "desktop:make:win": "npm run desktop:build && electron-forge make --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip",
    "desktop:dmg": "npm run desktop:package:mac && node electron/scripts/create-dmg.mjs",
    "desktop:verify-package": "vitest run electron/packaging-contract.test.mjs",
    "docs:generate": "node ../scripts/docs/documentation-health.mjs --write",
    "docs:check": "node ../scripts/docs/documentation-health.mjs",
    "encyclopedia:generate": "node scripts/encyclopedia/generate-core-assets.mjs",
    "encyclopedia:refresh-wiki": "node scripts/encyclopedia/import-wiki-dump.mjs",
    "encyclopedia:verify": "node scripts/encyclopedia/verify-encyclopedia-assets.mjs",
    "generate:icons": "node electron/scripts/generate-icons.mjs",
    "verify:icons": "node electron/scripts/generate-icons.mjs --check",
    "generate:tiles": "node scripts/generate-tile-assets.mjs",
    "verify:tiles": "node scripts/verify-tile-assets.mjs",
    "prebuild": "npm run docs:check && npm run verify:icons && npm run verify:tiles && npm run encyclopedia:verify && node scripts/verify-runtime-assets.mjs",
    "build": "tsc -b && vite build",
    "build:wasm": "../scripts/build-wasm.sh",
    "check:toolchain": "../scripts/build-wasm.sh --check-only",
    "test": "vitest run",
    "test:docs": "node --test ../scripts/docs/documentation-health.test.mjs",
    "test:tiles": "vitest run scripts/tiles",
    "test:watch": "vitest",
    "test:integration": "npm run test:integration:wasm && npm run test:integration:browser",
    "test:integration:wasm": "node test/integration-tests/wasm-test.mjs",
    "test:integration:browser": "playwright test",
    "test:integration:compat": "playwright test --config=playwright.compat.config.ts",
    "test:desktop": "npm run desktop:build && playwright test --config=playwright.desktop.config.ts",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "test:long": "playwright test --config=playwright.long.config.ts",
    "lint": "oxlint --ignore-pattern public/nethack.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "45.1.0",
    "oxlint": "^1.79.0",
    "pngjs": "^7.0.0",
    "saxes": "6.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.4",
    "vitest": "^4.1.12",
    "wikiparser-node": "1.48.0"
  }
}
